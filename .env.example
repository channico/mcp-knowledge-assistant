# Required for the OpenAI vector-store server and Responses API client.
OPENAI_API_KEY=
VECTOR_STORE_ID=

# Required only when calling the MCP server through an OpenAI secure tunnel.
MCP_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# Optional overrides.
OPENAI_MODEL=gpt-5.6-luna
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_SERVER_PORT=8000
